# ============================================================
# AtmoSync .gitignore
# ============================================================

# --- RUNTIME OUTPUT (generated data, not source) ---
data/pipeline_output/
logs/
*.log

# --- CREDENTIALS AND SECRETS (NEVER COMMIT) ---
.env
*.env
secrets.yml
secrets.yaml
credentials.json
profiles.yml

# --- PYTHON ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- VIRTUAL ENVIRONMENTS ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/

# --- TESTING ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- DBT ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# --- LOGS ---
*.log
logs/
*.log.*

# --- DATA FILES (large datasets) ---
data/raw/*.parquet
data/raw/*.csv
data/raw/*.json
# Keep sample_data tracked
!data/sample_data/

# --- JUPYTER ---
.ipynb_checkpoints/
*.ipynb

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- DOCKER ---
docker-volumes/
superset_home/
superset-data/

# --- KAFKA ---
kafka-data/
zookeeper-data/

# --- OS ---
desktop.ini
.DS_Store