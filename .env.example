# ============================================================
# AtmoSync – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git.
# ============================================================

# ------------------------------------------------------------
# SNOWFLAKE CONFIGURATION
# ------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_ROLE=SYSADMIN

# How to find your account identifier:
# In Snowflake UI: Admin > Accounts > copy the locator
# Format: orgname-accountname  (e.g. xy12345.us-east-1)

# ------------------------------------------------------------
# KAFKA CONFIGURATION
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR=atmosync-sensor-events
KAFKA_TOPIC_ALERTS=atmosync-alerts
KAFKA_GROUP_ID=atmosync-consumer-group

# ------------------------------------------------------------
# ALERT CONFIGURATION (Optional)
# ------------------------------------------------------------
# Slack webhook (get from: Slack > Apps > Incoming Webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email alerts (uses Gmail SMTP by default)
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient@example.com
ALERT_EMAIL_PASSWORD=your_app_password

# Alert thresholds
ALERT_SPOILAGE_THRESHOLD=0.70
ALERT_ARBITRAGE_MIN_MARGIN=500.00

# ------------------------------------------------------------
# SIMULATOR CONFIGURATION
# ------------------------------------------------------------
SIMULATOR_NUM_CONTAINERS=5
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_ANOMALY_PROBABILITY=0.15

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
